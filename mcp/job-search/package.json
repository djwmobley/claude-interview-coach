{
  "name": "job-search-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Node MCP job-scanning server for the interview-coach repo: crawling, dedup, and indexing outside the model.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node bin/run-tests.js",
    "test:db-setup": "node bin/bootstrap-test-db.js",
    "migrate": "node bin/migrate.js",
    "migrate:check": "node bin/migrate.js --check",
    "backfill-embeddings": "node bin/backfill-embeddings.js",
    "start": "node src/server.js",
    "scan": "node bin/scan.js",
    "remind": "node bin/remind.js",
    "config-lock": "node bin/config-lock.js"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cheerio": "^1.2.0",
    "google-auth-library": "^10.9.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "playwright-core": "^1.62.1",
    "zod": "^3.25.76"
  }
}
