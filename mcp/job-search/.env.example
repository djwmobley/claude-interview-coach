# Copy to mcp/job-search/.env and fill in. The real .env is gitignored.
# config.js loads this file itself (MCP launch does not run a shell).

# PostgreSQL DSN for the ic_context database (local trust auth, no password)
PG_DSN=postgresql://postgres@localhost:5432/ic_context

# Dedicated scan Chrome (NOT the daily-driver 9222 instance). Port is whatever this URL says.
SCAN_CDP_URL=http://127.0.0.1:9333
SCAN_PROFILE_DIR=C:\Users\<you>\chrome-scan-profile
CHROME_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe

# The operator's normal daily-driver Chrome (remote debugging), used only by
# bin/remind.js --open-dashboard to reload/focus an already-open dashboard tab. NOT the same browser
# instance as SCAN_CDP_URL above -- must stay on its own port. Only a loopback host is ever accepted.
# DAILY_CDP_URL=http://127.0.0.1:9222

# Ollama embeddings (must match tools/ic_memory.py)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mxbai-embed-large

# Optional overrides (defaults are relative to mcp/job-search/)
# JOBSEARCH_LOG_DIR=mcp/job-search/logs
# JOBSEARCH_CONFIG_DIR=mcp/job-search/config
# LOG_LEVEL=info

# Follow-up reminders (read-only use of the workspace-mcp OAuth token file)
GOOGLE_TOKEN_FILE=C:\Users\<you>\.google_workspace_mcp\credentials\<your-google-email>.json
REMINDER_TO=<your-google-email>

# In-run Google re-authorization (src/core/google-reauth.js). Comma-separated redirect URIs already
# registered on the Google Cloud Console OAuth client; leave unset to use the five registered
# http://localhost:8000-8004/oauth2callback defaults (the Google MCP itself usually holds 8000, so this
# flow binds whichever of the five is actually free at the moment it runs).
# GOOGLE_OAUTH_REDIRECT_URIS=http://localhost:8000/oauth2callback,http://localhost:8001/oauth2callback,http://localhost:8002/oauth2callback,http://localhost:8003/oauth2callback,http://localhost:8004/oauth2callback
# How long an interactive (dashboard/mcp-triggered, or --interactive) consent window stays open before
# giving up; milliseconds. Default 600000 (10 minutes).
# GOOGLE_REAUTH_TIMEOUT_MS=600000

# Local dashboard (optional; defaults to 7311). Must be an integer 1024-65535 or the dashboard falls
# back to 7311 with a logged warning.
# DASHBOARD_PORT=7311
