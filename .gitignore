# Personal data: ignored by default to prevent accidental exposure.
# If you use a private repo and want to version your data, remove these lines.
/data/
/coaching/

# Generated output (regenerable from data)
/output/

# PDF input files
/files/

# Python
__pycache__/
*.pyc

# Test plugins (personal experiments, not committed)
/plugins/test-*/

# System
nul
.DS_Store

# Personal session memory, research notes, and local tool state (public repo)
/memory/
/.memory-engine
/.playwright-mcp/
/*.png

# job-search MCP server: local env, logs, dependencies
**/.env
mcp/job-search/logs/
mcp/job-search/node_modules/
mcp/job-search/test/screenshots/
# Auto-triage candidate summary (slice 3): personal data, never committed. computeConfigHash() still
# hashes it (as "<missing>" here) via CONFIG_FILES, so an operator who creates a real one locally must
# run node bin/config-lock.js --write for that machine, same "config drift must be deliberate" rule
# every other config file gets.
mcp/job-search/config/triage-candidate.md
mcp/job-search/config/triage-candidate.lock
# Apply pipeline slice 4: the screening-question answer bank is personal data (EEO answers, salary
# floor), never committed. mcp/job-search/data/apply-answers.example.md (tracked) documents the format.
mcp/job-search/data/apply-answers.md
# Apply exclusion gate: blocked companies + applied-history are personal data (past employers, prior
# applications), never committed. mcp/job-search/config/apply-exclusions.example.json (tracked) documents
# the format. Never a CONFIG_FILES member and never part of config.lock.json (same treatment as
# triage-candidate.md above): its own presence/validity is checked at run time by src/apply/exclusions.js,
# not at config-lock time.
mcp/job-search/config/apply-exclusions.json
